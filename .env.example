# Public site URL (used by SEO helpers, sitemap, robots, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# libsql / Turso. For local dev use a file. For production set a libsql:// URL.
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# Better-Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32+char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional: transactional email (Resend). If unset, sendEmail() logs in dev.
# RESEND_API_KEY=

# Optional: error reporting. If set, captureException() flags it; wire @sentry/nextjs to actually report.
# SENTRY_DSN=

# Optional: Upstash for production rate limiting. The default rate limiter is in-memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
